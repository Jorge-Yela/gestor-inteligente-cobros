generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrganizationRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum InvoiceStatus {
  PENDING_REVIEW
  ACTIVE
  OVERDUE
  PAID
  CANCELLED
  ARCHIVED
}

enum PaymentStatus {
  UNPAID
  PAID
  DISPUTED
}

enum InvoiceFileStatus {
  UPLOADED
  OCR_PENDING
  OCR_PROCESSING
  OCR_COMPLETED
  OCR_FAILED
}

enum TimelineEventType {
  INVOICE_CREATED
  INVOICE_UPDATED
  INVOICE_MARKED_PAID
  CUSTOMER_CREATED
  NOTE_ADDED
}

enum TemplateTone {
  FRIENDLY
  FIRM
  FINAL_NOTICE
}

enum ClaimDraftStatus {
  DRAFT
  READY
  SENT
  CANCELLED
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  image     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships OrganizationMember[]
  timelineEvents TimelineEvent[]
}

model Organization {
  id              String   @id @default(cuid())
  name            String
  taxId           String?
  billingEmail    String?
  defaultCurrency String   @default("EUR")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  members        OrganizationMember[]
  customers      Customer[]
  invoices       Invoice[]
  invoiceFiles   InvoiceFile[]
  timelineEvents TimelineEvent[]
  templates      Template[]
  claimDrafts    ClaimDraft[]
}

model OrganizationMember {
  id             String           @id @default(cuid())
  userId         String
  organizationId String
  role           OrganizationRole @default(MEMBER)
  createdAt      DateTime         @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model Customer {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  taxId          String?
  email          String?
  phone          String?
  contactName    String?
  address        String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoices     Invoice[]
  claimDrafts ClaimDraft[]

  @@index([organizationId])
  @@index([name])
}

model Invoice {
  id             String        @id @default(cuid())
  organizationId String
  customerId     String
  invoiceNumber  String
  issueDate      DateTime?
  dueDate        DateTime?
  amountCents    Int
  currency       String        @default("EUR")
  status         InvoiceStatus @default(PENDING_REVIEW)
  paymentStatus  PaymentStatus @default(UNPAID)
  paidAt         DateTime?
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer       Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  timelineEvents TimelineEvent[]
  file           InvoiceFile?
  claimDrafts    ClaimDraft[]

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId])
  @@index([customerId])
  @@index([status])
  @@index([paymentStatus])
}

model TimelineEvent {
  id             String            @id @default(cuid())
  organizationId String
  invoiceId      String?
  userId         String?
  type           TimelineEventType
  title          String
  description    String?
  metadata       Json?
  createdAt      DateTime          @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice      Invoice?     @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([invoiceId])
  @@index([userId])
}


model Template {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  subject        String
  body           String
  tone           TemplateTone @default(FRIENDLY)
  language       String       @default("es")
  isDefault      Boolean      @default(false)
  archivedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  claimDrafts  ClaimDraft[]

  @@index([organizationId])
  @@index([tone])
}


model ClaimDraft {
  id             String           @id @default(cuid())
  organizationId String
  invoiceId      String
  customerId     String
  templateId     String?
  subject        String
  body           String
  status         ClaimDraftStatus @default(DRAFT)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice      Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  template     Template?    @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([invoiceId])
  @@index([customerId])
  @@index([status])
}


model InvoiceFile {
  id              String            @id @default(cuid())
  organizationId  String
  invoiceId       String?           @unique
  fileName        String
  fileUrl         String
  fileKey         String?
  mimeType        String            @default("application/pdf")
  sizeBytes       Int?
  status          InvoiceFileStatus @default(UPLOADED)
  extractedText   String?
  extractedData   Json?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice      Invoice?     @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([invoiceId])
  @@index([status])
}
